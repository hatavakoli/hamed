# =============================================================================
# YouTube Content Intelligence Monitor — environment variables
# =============================================================================
# Copy this file to `.env` and fill it in:   cp .env.example .env
#
# LEGEND
#   [REQUIRED]  the app will not start without it
#   [IMPORTANT] strongly recommended before you expose the app to the internet
#   [OPTIONAL]  leave blank and a safe local mock is used instead
# =============================================================================


# -----------------------------------------------------------------------------
# Database  [REQUIRED]
# -----------------------------------------------------------------------------
# Local development (Postgres running on your machine or via docker compose):
DATABASE_URL="postgresql://ycim:ycim_password@localhost:5432/ycim?schema=public"
#
# Inside Docker Compose the host is the service name, not localhost:
# DATABASE_URL="postgresql://ycim:ycim_password@db:5432/ycim?schema=public"

# Used by docker-compose.yml to create the Postgres container.
POSTGRES_USER=ycim
POSTGRES_PASSWORD=ycim_password
POSTGRES_DB=ycim


# -----------------------------------------------------------------------------
# Security  [IMPORTANT]
# -----------------------------------------------------------------------------
# Signs your login cookie AND encrypts any API keys saved through the UI.
# Generate one with:   openssl rand -base64 32
# Changing it logs everyone out and makes UI-saved secrets unreadable.
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"

# Public URL of the app. Used in emails and for absolute links.
NEXTAUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# The single admin account. You can also create one in the setup wizard instead.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-at-least-8-chars"

# Shared secret for POST /api/cron/* so an external scheduler can trigger jobs
# without a browser session. Leave blank if you only use the worker container.
# Generate with:   openssl rand -hex 24
CRON_SECRET=""


# -----------------------------------------------------------------------------
# Local development / demo mode
# -----------------------------------------------------------------------------
# true  = never call a real API. Fake YouTube, transcripts, AI and email.
#         Perfect for trying the whole app before you buy any credits.
# false = use the real services below (falling back to a mock for any key you
#         have not provided).
MOCK_MODE=true

APP_NAME="YouTube Content Intelligence Monitor"
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# YouTube Data API v3  [OPTIONAL — required for real channels]
# -----------------------------------------------------------------------------
# Google Cloud Console → Create project → Enable "YouTube Data API v3"
#   → Credentials → Create API key.
# The free quota (10,000 units/day) is plenty for a handful of channels.
YOUTUBE_API_KEY=""


# -----------------------------------------------------------------------------
# Anthropic Claude  [OPTIONAL — required for real analysis]
# -----------------------------------------------------------------------------
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Force a provider. Leave blank to auto-detect: anthropic when a key exists,
# otherwise the built-in mock. Options: anthropic | mock
AI_PROVIDER=""


# -----------------------------------------------------------------------------
# Transcripts  [OPTIONAL]
# -----------------------------------------------------------------------------
# YouTube only lets you download captions for channels you OWN, so for
# third-party channels you need a transcript provider. Point this at any HTTP
# endpoint that accepts ?videoId=<id> and returns JSON containing either
# { "text": "..." } or { "segments": [{ start, duration, text }] }.
#
# Options: api | youtube | mock | none
TRANSCRIPT_PROVIDER=""
TRANSCRIPT_API_URL=""
TRANSCRIPT_API_KEY=""


# -----------------------------------------------------------------------------
# Email via Resend  [OPTIONAL]
# -----------------------------------------------------------------------------
# https://resend.com → API keys. Without a key, every notification is printed
# to the server terminal instead of being sent — nothing breaks.
RESEND_API_KEY=""
# Must be a verified sender in Resend. resend.dev works for testing.
EMAIL_FROM="onboarding@resend.dev"


# -----------------------------------------------------------------------------
# Jobs
# -----------------------------------------------------------------------------
# How often the worker sweeps all channels (minutes). Editable later in Settings.
MONITOR_INTERVAL_MINUTES=60
# Cap on how many new videos a single check queues (protects quota and budget).
MAX_VIDEOS_PER_CHECK=5

# NOT USED YET. Reserved for a future BullMQ queue. The MVP uses node-cron plus
# a database-backed job table, which is sufficient for a single VPS.
REDIS_URL=""
